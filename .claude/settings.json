{
  "sandbox": {
    "enabled": false
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Read(~/.slack/credentials.json)",
      "Edit(~/.slack/credentials.json)",
      "Edit(/**/.env*)",
      "Read(/**/.credentials*)",
      "Edit(/**/.credentials*)",
      "Read(/**/secrets/**)",
      "Edit(/**/secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(cat /proc/*/environ*)"
    ]
  }
}
